# ---------------------------------------------------------------------------
# FrontierTechSN environment template. Copy to .env and fill in secrets:
#   cp .env.example .env
#
# Everything below is now editable in the app: Admin -> System. The values here
# are only the *seed* — on save, the Admin console writes data/settings.json,
# which is layered on top of this file at startup and applied live. "Reset to
# default" in the UI restores whatever this file (or the built-in fallback)
# says, so .env stays useful as the baseline for a fresh machine.
#
# A .env is entirely optional: the app runs on its built-in defaults, and every
# knob can be set from the Admin console instead.
# ---------------------------------------------------------------------------

# ---- AI backend -----------------------------------------------------------
# Which backend drives the digestion + scriptwriting AI calls:
#   agent_sdk  (default) — Claude Agent SDK (spawns the `claude` CLI, talks the
#                          Anthropic protocol to the gateway below)
#   http                 — legacy direct OpenAI-compatible HTTP client
AI_BACKEND=agent_sdk

# Provider registry seed / default (OpenAI-compatible endpoint, key, model).
# Used by both backends. For agent_sdk, the endpoint host is reinterpreted as
# an Anthropic base URL unless ANTHROPIC_BASE_URL is set explicitly below.
AI_ENDPOINT=http://oneapi.yhroot.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=glm-4.6-chat
AI_TIMEOUT=600
AI_MAX_RETRIES=9
AI_RETRY_BASE_SECONDS=4
AI_RETRY_MAX_SECONDS=60
AI_YINHE_MIN_REQUEST_INTERVAL_SECONDS=7
AI_PRIMARY_MIN_REQUEST_INTERVAL_SECONDS=15
AI_PRIMARY_RATE_LIMIT_COOLDOWN_SECONDS=65
AI_PRIMARY_RATE_LIMIT_MAX_WAITS=6
AI_PRIMARY_RATE_LIMIT_TIMEZONE=Asia/Singapore
AI_PRIMARY_RATE_LIMIT_START_HOUR=8
AI_PRIMARY_RATE_LIMIT_END_HOUR=20
AI_PRIMARY_MAX_RETRIES=3
AI_BACKUP_MAX_RETRIES=2

# ---- Claude Agent SDK / Anthropic protocol --------------------------------
# Leave blank to derive from AI_ENDPOINT/AI_API_KEY above. Set explicitly to
# point at a gateway whose Anthropic route lives on a sub-path, e.g. DeepSeek:
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
# Path to the `claude` CLI. Blank = SDK auto-locates (bundled, else on PATH).
CLAUDE_CLI_PATH=
# One CLI process makes one request; the pipeline owns paced, bounded retries.
AGENT_INTERNAL_MAX_RETRIES=0
AGENT_REQUEST_TIMEOUT=600
AGENT_TURN_TIMEOUT=900

# ---- Source extraction (yt-dlp) -------------------------------------------
# start.sh exports a detected node runtime and YTDLP_COOKIES_FROM_BROWSER=chrome
# before launching; set them here (or in Admin) to override that.
YTDLP_JS_RUNTIME=
YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=

# ---- Footage sources (Wikimedia + YouTube web scout) ----------------------
# Wikimedia needs no key. Web-platform clips are marked rights-review-required.
FOOTAGE_USER_AGENT="FrontierTechSN/1.0 (local AI media scout)"
FOOTAGE_TIMEOUT=45
FOOTAGE_MAX_BYTES=52428800
FOOTAGE_RENDER_MAX_WIDTH=1920
FOOTAGE_RENDER_MAX_HEIGHT=1080
FOOTAGE_RENDER_MAX_SECONDS=20
FOOTAGE_RENDER_CRF=23
# Scene-grounded news stills: OpenCLI plans/researches the subject and
# Wikimedia Commons supplies only open-license local assets.
NEWS_IMAGE_MAX_BYTES=12582912
NEWS_IMAGE_OPENCLI_TIMEOUT=45
NEWS_IMAGE_OPENCLI_ATTEMPTS=1
NEWS_IMAGE_SEARCH_TIMEOUT=60
OPENCLI_BIN=./scripts/opencli.sh
OPENCLI_PROFILE=
# Explicit model for Gemini ask (text/image understanding), verified in the UI.
OPENCLI_GEMINI_MODEL=3.1-pro
# Existing behavior remains the default. isolated-headless starts a dedicated
# Chrome for Testing/Chromium process and never falls back to operator Chrome.
OPENCLI_BROWSER_RUNTIME=bridge
OPENCLI_ISOLATED_CHROME_BIN=
OPENCLI_ISOLATED_USER_DATA_DIR=data/opencli-isolated-browser
OPENCLI_ISOLATED_EXTENSION_PATH=
OPENCLI_ISOLATED_PROFILE=
OPENCLI_ISOLATED_DEBUG_PORT=19242
OPENCLI_ISOLATED_START_TIMEOUT=30
# Keep persistent Browser Bridge tabs separate from other local OpenCLI projects.
OPENCLI_SITE_SESSION_NAMESPACE=frontiertechsn
OPENCLI_TIMEOUT=180
OPENCLI_MAX_ATTEMPTS=10
OPENCLI_RETRY_BASE_SECONDS=3
# Shared Gemini/ChatGPT OpenCLI request spacing (allowed range: 600–1800 seconds).
OPENCLI_WEB_REQUEST_INTERVAL_SECONDS=600
# Daily-news fact check: try the minimum level first, then accept the current
# level only when a failed switch leaves it inside this non-Pro range.
DAILY_NEWS_CHATGPT_REVIEW_MIN_LEVEL=medium
DAILY_NEWS_CHATGPT_REVIEW_MAX_LEVEL=xhigh
DAILY_NEWS_WEB_REVIEW_TIMEOUT=90
THUMBNAIL_CHATGPT_TIMEOUT=360
COLLAGE_CHATGPT_TIMEOUT=420
COLLAGE_GEMINI_TIMEOUT=1800
COLLAGE_GEMINI_STALL_TIMEOUT=600
COLLAGE_GEMINI_MAX_SECONDS=8
# Final rendered-pixel review uses Gemini first. If Gemini exhausts its
# attempts without returning the required JSON schema, retry the same contact
# sheet with the signed-in ChatGPT vision provider before deferring promotion.
AV_SYNC_REVIEW_FALLBACK_PROVIDER=chatgpt
WEB_FOOTAGE_ENABLED=1
# Master publication safety switch. Keep disabled until the platform switches
# and exact target identities below are configured and verified.
VIDEO_AUTO_PUBLISH_ENABLED=0
VIDEO_PUBLISH_YOUTUBE_ENABLED=1
VIDEO_PUBLISH_YOUTUBE_CHANNEL_NAME=
VIDEO_PUBLISH_YOUTUBE_CHANNEL_ID=
VIDEO_PUBLISH_X_ENABLED=1
VIDEO_PUBLISH_X_HANDLE=
# This adapter maintains RSS; it does not control an Apple Podcasts account.
VIDEO_PUBLISH_APPLE_PODCAST_ENABLED=1
VIDEO_PUBLISH_APPLE_FEED_TITLE=ByteFront Espresso
VIDEO_PUBLISH_APPLE_FEED_AUTHOR=FrontierTechSN
VIDEO_PUBLISH_APPLE_FEED_PUBLIC_BASE_URL=
WEB_FOOTAGE_GEMINI_ENABLED=1
WEB_FOOTAGE_GEMINI_TIMEOUT=120
# Total attempts per preview: up to 3 in a batch, the rest individually.
# Valid suitability rejections are terminal; provider pacing still applies.
WEB_FOOTAGE_PREVIEW_MAX_ATTEMPTS=6
WEB_FOOTAGE_CLIP_SECONDS=15
WEB_FOOTAGE_CLIP_MIN_SECONDS=10
WEB_FOOTAGE_DOWNLOAD_TIMEOUT=600

# ---- TTS (local VibeVoice + remote Orpheus) -------------------------------
# VibeVoice runs locally with Apple MPS. Orpheus uses the authenticated remote
# async API; keep its key blank here and set it in Admin -> System or a private
# .env file.
AIWORK_ROOT=/Volumes/TP-1TB/AIWork
TTS_DEVICE=mps
TTS_DEFAULT_MODEL=vibevoice-0.5b
TTS_DEFAULT_VOICE_1=Carter
TTS_DEFAULT_VOICE_2=Alice
# VibeVoice-only safety limit. Each chunk reuses the same voice preset and RNG
# seed, and the application joins PCM frames without re-encoding. Orpheus uses
# short, independently transcribed utterances so prompt text cannot be skipped.
VIBEVOICE_TTS_CHUNK_WORDS=350
TTS_RANDOM_SEED=42
# Synthesis is watched by silence, not elapsed time. A full-length script
# legitimately decodes for hours, but VibeVoice prints progress several times a
# second, so TTS_STALL_TIMEOUT (seconds with no output at all) is what catches a
# genuinely wedged run. TTS_TIMEOUT is only a coarse ceiling on total runtime.
TTS_STALL_TIMEOUT=600
TTS_TIMEOUT=21600
ORPHEUS_TTS_URL=http://10.60.11.3:8088
ORPHEUS_TTS_API_KEY=
ORPHEUS_TTS_MAX_TOKENS=16384
ORPHEUS_TTS_CHUNK_WORDS=12
ORPHEUS_TTS_N_THREADS=64
ORPHEUS_TTS_POLL_SECONDS=2
ORPHEUS_TTS_REQUEST_TIMEOUT=60
# Pocket TTS runs as a separate Docker service on nr-test. Its own tokenizer
# performs natural sentence-level splitting, so the application keeps each
# physical script line/story together and only splits very long lines between
# complete sentences. Pin this revision to the Docker checkout in
# /home/guoliang/pocket-tts.
POCKET_TTS_URL=http://10.60.11.3:8090
POCKET_TTS_API_KEY=
POCKET_TTS_MODEL_REVISION=adde0654090b1d54f6ee416ed10fd1b108069f13
POCKET_TTS_CHUNK_WORDS=240
POCKET_TTS_REQUEST_TIMEOUT=900

# ---- HyperFrames render ---------------------------------------------------
HYPERFRAME_DIR=./hyperframe
HYPERFRAMES_VERSION=0.6.99
RENDER_RESOLUTION=landscape
RENDER_FPS=15
RENDER_QUALITY=draft
RENDER_WORKERS=2
RENDER_PROTOCOL_TIMEOUT_MS=900000

# ---- Video direction ------------------------------------------------------
# Claude Agent SDK crews author the per-scene compositions on top of the
# deterministic drafts. Every file they write is checked against the HyperFrames
# runtime contract and reverted to its draft if it fails, so turning this off
# only costs visual variety — never a working render.
DIRECTOR_ENABLED=1
# Hand only the first N scenes to agents (0 = all). Each crew is a `claude` CLI
# process and a provider round-trip: this is the cost/latency dial.
DIRECTOR_MAX_SCENES=0
# Run `hyperframes inspect` before the render and let the agents repair the
# layout failures it reports (overlapping text, content spilling out of frame).
# Costs a headless-Chrome pass over the timeline.
INSPECT_ENABLED=1

# ---- Paths ----------------------------------------------------------------
OUTPUTS_DIR=./outputs
UPLOADS_DIR=./uploads
DB_PATH=
ISLA_READER_PROMOTION_SCRIPT=

# ---- Launch-only (not in Admin) -------------------------------------------
# Read by scripts/start.sh before the app exists, so these cannot be settings.
#   PORT=8101
#   HOST=0.0.0.0
#   SKIP_FRONTEND_BUILD=0
#   LOG_DIR=./logs
